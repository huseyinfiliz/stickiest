{
    "name": "@huseyinfiliz/stickiest",
    "private": true,
    "version": "0.0.0",
    "packageManager": "yarn@4.12.0",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@babel/core": "^8.1.3",
        "@flarum/prettier-config": "^1.0.0",
        "@jest/globals": "^30.5.2",
        "@types/babel__core": "^7",
        "babel-jest": "^30.5.2",
        "flarum-tsconfig": "^2.0.0",
        "flarum-webpack-config": "^3.1.0",
        "jest": "^30.5.2",
        "prettier": "^3.10.1",
        "typescript": "^5.9.3",
        "typescript-coverage-report": "^2.1.2",
        "webpack": "^5.104.1",
        "webpack-cli": "^7.3.1"
    },
    "resolutions": {
        "glob": "^14.0.6",
        "test-exclude/minimatch": "^11.0.9",
        "type-coverage-core/minimatch": "^11.0.1"
    },
    "scripts": {
        "dev": "webpack --mode development --watch",
        "build": "webpack --mode production",
        "analyze": "ANALYZER=true yarn build",
        "format": "prettier --write src",
        "format-check": "prettier --check src",
        "clean-typings": "rm -rf dist-typings && mkdir dist-typings",
        "build-typings": "yarn clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && yarn post-build-typings",
        "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
        "check-typings": "tsc --noEmit --emitDeclarationOnly false",
        "check-typings-coverage": "typescript-coverage-report",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
    },
    "prettier": "@flarum/prettier-config",
    "type": "module",
    "optionalDependencies": {
        "fsevents": "^2.3.3"
    }
}
